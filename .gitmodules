[submodule "dotfiles/.zsh/pure"]
	path = dotfiles/.zsh/pure
	url = https://github.com/sindresorhus/pure.git
[submodule "dotfiles/.zsh/zsh-autosuggestions"]
	path = dotfiles/.zsh/zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions
[submodule "dotfiles/.config/nvim"]
	path = dotfiles/.config/nvim
	url = git@github.com:mollersander/nvim.git
