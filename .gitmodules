[submodule "dotfiles/.zsh/pure"]
	path = dotfiles/.zsh/pure
	url = https://github.com/sindresorhus/pure.git
[submodule "dotfiles/.zsh/zsh-autosuggestions"]
	path = dotfiles/.zsh/zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions
[submodule "dotfiles/.config/nvim"]
	path = dotfiles/.config/nvim
	url = git@github.com:mollersander/nvim.git
[submodule "dotfiles/.zsh/zsh-syntax-highlighting"]
	path = dotfiles/.zsh/zsh-syntax-highlighting
	url = https://github.com/zsh-users/zsh-syntax-highlighting.git
[submodule "dotfiles/.zsh/zsh-autocomplete"]
	path = dotfiles/.zsh/zsh-autocomplete
	url = https://github.com/marlonrichert/zsh-autocomplete.git
[submodule "dotfiles/.zsh/zsh-history-substring-search"]
	path = dotfiles/.zsh/zsh-history-substring-search
	url = https://github.com/zsh-users/zsh-history-substring-search.git
